<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#00BCD4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txt_tieude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHẬP THÔNG TIN SINH VIN"
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="150dp"
        />
    <EditText
        android:id="@+id/txt_ma"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:background="@drawable/custom_edt"
        android:hint="Nhập mã sv"
        android:paddingLeft="20dp"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textColorHint="#DEDEDE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_tieude"
        android:layout_marginTop="100dp"
        />
    <EditText
        android:id="@+id/txt_ten"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:background="@drawable/custom_edt"
        android:hint="Nhập tên sv"
        android:paddingLeft="20dp"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textColorHint="#DEDEDE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_ma"
        android:layout_marginTop="20dp"
        />
    <EditText
        android:id="@+id/txt_diem"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:background="@drawable/custom_edt"
        android:hint="Nhập điểm"
        android:paddingLeft="20dp"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:textColorHint="#DEDEDE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_ten"
        android:layout_marginTop="20dp"
        />
    <Button
        android:id="@+id/btn_xn"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_diem"
        android:layout_marginTop="40dp"
        android:textSize="20dp"
        android:background="@drawable/custom_btn"
        app:backgroundTint="@null"
        android:textColor="@color/white"
        android:text="xác nhận"
        android:textStyle="bold"/>

</androidx.constraintlayout.widget.ConstraintLayout>